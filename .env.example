# =============================================================================
# MysticalPIECES — Environment variables (copy to .env and fill in)
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required for PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional: for connection poolers (e.g. Vercel Postgres). Use same as DATABASE_URL locally.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# -----------------------------------------------------------------------------
# Authentication & sessions (required for production)
# -----------------------------------------------------------------------------
# NextAuth (if using NextAuth.js)
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="https://mysticalpieces.com"

# Or custom session (if not using NextAuth)
# SESSION_SECRET="generate-with-openssl-rand-base64-32"

# -----------------------------------------------------------------------------
# Email (existing — optional)
# -----------------------------------------------------------------------------
# SENDGRID_API_KEY=
# FROM_EMAIL="noreply@mysticalpieces.com"
# FROM_NAME="Mystical PIECES"

# SMTP fallback
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# -----------------------------------------------------------------------------
# WhatsApp (existing — optional)
# -----------------------------------------------------------------------------
# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=

# Meta Business API
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Green API
# GREEN_API_ID_INSTANCE=
# GREEN_API_TOKEN_INSTANCE=
# GREEN_API_URL=
