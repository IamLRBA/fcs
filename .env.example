# MysticalPIECES environment template
# Copy this file to .env and fill real values.

# -----------------------------------------------------------------------------
# Core required variables
# -----------------------------------------------------------------------------
# Runtime DB URL (pooled URL if your host uses PgBouncer)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Direct DB URL (non-pooled) used by Prisma directUrl
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Public app URL (Koyeb/custom domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: only used by local docker-compose Postgres
# POSTGRES_PASSWORD=generate-a-long-random-secret

# -----------------------------------------------------------------------------
# Email notifications (optional)
# -----------------------------------------------------------------------------
# Option A: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# FROM_EMAIL=mysticalpieces@gmail.com
# FROM_NAME=Mystical PIECES

# Option B: SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password-or-app-password
# FROM_EMAIL=you@example.com
# FROM_NAME=Mystical PIECES

# -----------------------------------------------------------------------------
# WhatsApp notifications (optional)
# -----------------------------------------------------------------------------
# Meta Business API
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Green API
# GREEN_API_ID_INSTANCE=
# GREEN_API_TOKEN_INSTANCE=
# GREEN_API_URL=
