# MysticalPIECES environment template
# Copy this file to .env and fill real values.

# -----------------------------------------------------------------------------
# Core required variables
# -----------------------------------------------------------------------------
# Runtime DB URL (pooled URL if your host uses PgBouncer)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Direct DB URL (non-pooled) used by Prisma directUrl
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Public app URL (Koyeb/custom domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: canonical HTTPS URL for server-to-server calls (WhatsApp internal fetch).
# On Koyeb set to your live URL, e.g. https://your-app-xxxxx.koyeb.app
# INTERNAL_APP_URL=https://your-production-host

# Optional: only used by local docker-compose Postgres
# POSTGRES_PASSWORD=generate-a-long-random-secret

# -----------------------------------------------------------------------------
# Email notifications (optional)
# -----------------------------------------------------------------------------
# Use EITHER SendGrid OR SMTP — not both. If SENDGRID_API_KEY is set, SendGrid
# is tried first; remove it to use SMTP only.

# Option A: SendGrid (omit all of these to use SMTP only)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# FROM_EMAIL=verified-sender@yourdomain.com
# FROM_NAME=Mystical PIECES

# Option B: SMTP (e.g. Gmail — remove SENDGRID_API_KEY from production)
# 1) Google Account → Security → 2-Step Verification ON
# 2) Google Account → Security → App passwords → Mail / Other → copy 16-char password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=mysticalpieces@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# FROM_EMAIL=mysticalpieces@gmail.com
# FROM_NAME=Mystical PIECES

# -----------------------------------------------------------------------------
# WhatsApp notifications (optional)
# -----------------------------------------------------------------------------
# Meta Business API
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Green API
# GREEN_API_ID_INSTANCE=
# GREEN_API_TOKEN_INSTANCE=
# GREEN_API_URL=
